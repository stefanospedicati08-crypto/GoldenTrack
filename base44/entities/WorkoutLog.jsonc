{
  "name": "WorkoutLog",
  "type": "object",
  "properties": {
    "exercise_id": {
      "type": "string",
      "title": "ID Esercizio"
    },
    "plan_id": {
      "type": "string",
      "title": "ID Scheda"
    },
    "exercise_name": {
      "type": "string",
      "title": "Nome Esercizio"
    },
    "set_number": {
      "type": "number",
      "title": "Numero Serie"
    },
    "reps_done": {
      "type": "number",
      "title": "Ripetizioni Fatte"
    },
    "weight_kg": {
      "type": "number",
      "title": "Carico 1 (kg)"
    },
    "weight_kg_2": {
      "type": "number",
      "title": "Carico 2 (kg)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "notes": {
      "type": "string",
      "title": "Note"
    },
    "is_warmup": {
      "type": "boolean",
      "title": "Warm Up"
    }
  },
  "required": [
    "exercise_id",
    "plan_id",
    "exercise_name",
    "set_number",
    "date"
  ]
}