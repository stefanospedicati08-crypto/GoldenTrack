{
  "name": "WorkoutSession",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "title": "ID Scheda"
    },
    "day_label": {
      "type": "string",
      "title": "Giorno"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "rpe": {
      "type": "number",
      "minimum": 1,
      "maximum": 10,
      "title": "RPE (1-10)"
    },
    "heart_rate_avg": {
      "type": "number",
      "title": "Frequenza Cardiaca Media (bpm)"
    },
    "athlete_note": {
      "type": "string",
      "title": "Note Atleta"
    }
  },
  "required": [
    "plan_id",
    "date"
  ]
}