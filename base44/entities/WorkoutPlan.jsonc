{
  "name": "WorkoutPlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titolo Scheda"
    },
    "description": {
      "type": "string",
      "title": "Descrizione"
    },
    "assigned_to": {
      "type": "string",
      "title": "Assegnato a (email)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "archived"
      ],
      "title": "Stato"
    },
    "pdf_url": {
      "type": "string",
      "title": "PDF Originale"
    },
    "notes": {
      "type": "string",
      "title": "Note Trainer"
    }
  },
  "required": [
    "title",
    "assigned_to"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}