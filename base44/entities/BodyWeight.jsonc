{
  "name": "BodyWeight",
  "type": "object",
  "properties": {
    "weight_kg": {
      "type": "number",
      "title": "Peso (kg)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "notes": {
      "type": "string",
      "title": "Note"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto"
    }
  },
  "required": [
    "weight_kg",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}