{
  "name": "TrainerRequest",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "title": "Email Utente"
    },
    "user_name": {
      "type": "string",
      "title": "Nome Utente"
    },
    "notes": {
      "type": "string",
      "title": "Motivazione"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "Stato"
    }
  },
  "required": [
    "user_email",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "trainer"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}