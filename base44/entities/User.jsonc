{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "trainer"
      ],
      "title": "Ruolo"
    },
    "first_name": {
      "type": "string",
      "title": "Nome"
    },
    "last_name": {
      "type": "string",
      "title": "Cognome"
    },
    "birth_year": {
      "type": "number",
      "title": "Anno di Nascita"
    },
    "weight_goal": {
      "type": "number",
      "title": "Obiettivo Peso (kg)"
    },
    "weight_goal_date": {
      "type": "string",
      "format": "date",
      "title": "Data Obiettivo"
    },
    "height_cm": {
      "type": "number",
      "title": "Altezza (cm)"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto Profilo"
    },
    "meal_plan_url": {
      "type": "string",
      "title": "Piano Alimentare"
    }
  },
  "required": [
    "role",
    "first_name",
    "last_name",
    "birth_year",
    "weight_goal",
    "weight_goal_date",
    "height_cm",
    "photo_url",
    "meal_plan_url"
  ]
}