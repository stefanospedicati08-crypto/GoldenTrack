{
  "name": "Exercise",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "title": "ID Scheda"
    },
    "name": {
      "type": "string",
      "title": "Nome Esercizio"
    },
    "muscle_group": {
      "type": "string",
      "title": "Gruppo Muscolare"
    },
    "sets": {
      "type": "number",
      "title": "Serie"
    },
    "reps": {
      "type": "string",
      "title": "Ripetizioni"
    },
    "rest_seconds": {
      "type": "number",
      "title": "Recupero (sec)"
    },
    "notes": {
      "type": "string",
      "title": "Note Trainer"
    },
    "athlete_note": {
      "type": "string",
      "title": "Nota Atleta"
    },
    "order_index": {
      "type": "number",
      "title": "Ordine"
    },
    "day_label": {
      "type": "string",
      "title": "Giorno"
    }
  },
  "required": [
    "plan_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.plan_id": {
            "$in": {
              "entity": "WorkoutPlan",
              "field": "id",
              "query": {
                "data.assigned_to": "{{user.email}}"
              }
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.plan_id": {
                "$in": {
                  "entity": "WorkoutPlan",
                  "field": "id",
                  "query": {
                    "data.assigned_to": "{{user.email}}"
                  }
                }
              }
            },
            {
              "$set": {
                "data.athlete_note": "$$current.data.athlete_note"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}